# 数据库连接（Docker 内网使用 mysql 容器名）
DATABASE_URL=mysql://root:root@mysql:3306/dunhuang_agent

# LLM 配置（仅 sql_builder_draft 工具使用）
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 服务配置
MCP_SERVER_PORT=3100
SQL_TIMEOUT_MS=30000
MAX_RESULT_ROWS=1000

# 安全配置
SQL_AGENT_ALLOWED_TABLES=weather_data,station_info,weather_directory,conditions,dict,dict_item,ditor,files,more,roles,router_menu,tests,theme,user
SQL_AGENT_ALLOWED_SCHEMAS=dunhuang_agent
